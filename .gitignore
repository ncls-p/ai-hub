# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/.playwright-cli/

# next.js
/.next/
/out/
/public/vendor/swagger-ui-bundle.js

# production
/build

# python
__pycache__/
*.py[cod]

# misc
.DS_Store
*.pem

# local app/agent caches (keep .agents/ skills and AGENT*.md tracked)
.pi-lens/
.data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep documented examples tracked)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
.devtools
